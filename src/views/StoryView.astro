---
import { Picture, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import PageHero from '../components/PageHero.astro';
import Timeline from '../components/Timeline.astro';
import Slideshow from '../components/Slideshow.astro';
import CtaBand from '../components/CtaBand.astro';
import Footer from '../components/Footer.astro';
import heroPhoto from '../assets/photos/zgodba-hero.jpg';
import treeScan from '../assets/photos/zgodba/druzinsko-drevo.jpg';
import toast from '../assets/photos/zgodba/01-nazdravljamo.jpg';
import pergola from '../assets/photos/zgodba/02-brajde.jpg';
import youngest from '../assets/photos/zgodba/03-najmlajsi.jpg';
import table from '../assets/photos/zgodba/04-za-mizo.jpg';
import robe from '../assets/photos/zgodba/05-kraljevski-plasc.jpg';
import award from '../assets/photos/zgodba/06-priznanje.jpg';
import doorway from '../assets/photos/zgodba/07-vrata-1897.jpg';
import presenting from '../assets/photos/zgodba/08-predstavitev.jpg';
import team from '../assets/photos/zgodba/09-ekipa.jpg';
import carafe from '../assets/photos/zgodba/10-domace-vino.jpg';
import { getContent, routes, otherLang, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang);
const s = t.story;

/* The family tree at full resolution, for reading the hand-writing up close. */
const treeFull = await getImage({ src: treeScan, format: 'jpg', width: treeScan.width });

/* The photographs in order; their alt text lives with the copy, in the same order. */
const slides = [
  { src: toast, position: '50% 35%' },
  { src: youngest, position: '50% 58%' },
  { src: pergola, position: '45% 60%' },
  { src: table, position: '50% 45%' },
  { src: robe, position: '50% 40%' },
  { src: award, position: '50% 42%' },
  { src: doorway, position: '50% 42%' },
  { src: presenting, position: '50% 24%' },
  { src: team, position: '50% 55%' },
  { src: carafe, position: '50% 45%' },
].map((slide, i) => ({ ...slide, alt: s.slides.alts[i] }));
---

<Base lang={lang} page="story" ogImage={heroPhoto} ogImageAlt={s.heroAlt}>
  <Nav lang={lang} toggleHref={routes[otherLang(lang)].story} />

  <PageHero photo={heroPhoto} alt={s.heroAlt} title={s.title} standfirst={s.standfirst} position="50% 40%" whole />

  <main class="wrap">
    {/* The family's years, the same timeline the homepage carries, under its gold caption. */}
    <section class="years years--page" aria-labelledby="druzina-s-tradicijo">
      <h2 class="years-kicker" id="druzina-s-tradicijo" data-reveal>{t.home.yearsHead}</h2>
      <Timeline lang={lang} />
    </section>

    {/* The family tree as the document itself — names and dates in the original hand. */}
    <section class="tree" aria-labelledby="druzinsko-drevo">
      <h2 class="years-kicker" id="druzinsko-drevo" data-reveal>{s.tree.head}</h2>
      <figure class="tree-figure" data-reveal>
        <a class="tree-link" href={treeFull.src} target="_blank" rel="noopener" aria-label={s.tree.open}>
          <Picture
            class="tree-scan"
            pictureAttributes={{ class: 'pic' }}
            src={treeScan}
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            widths={[480, 720, 1080, 1440]}
            sizes="(max-width: 759.98px) 100vw, 720px"
            loading="lazy"
            alt={s.tree.alt}
          />
        </a>
        <figcaption class="tree-caption">
          {s.tree.caption}
          <a class="tree-open" href={treeFull.src} target="_blank" rel="noopener">{s.tree.open}</a>
        </figcaption>
      </figure>
    </section>

    <Slideshow slides={slides} label={s.slides.label} prev={s.slides.prev} next={s.slides.next} />

    <CtaBand lang={lang} heading={s.cta.heading} secondary={s.cta.secondary} />
  </main>

  <Footer lang={lang} />
</Base>
