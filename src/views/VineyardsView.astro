---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import PageHero from '../components/PageHero.astro';
import Stats from '../components/Stats.astro';
import CtaBand from '../components/CtaBand.astro';
import Footer from '../components/Footer.astro';
import heroPhoto from '../assets/photos/vinogradi-hero.jpg';
import trskaGora from '../assets/photos/vineyards/trska-gora.jpg';
import razbore from '../assets/photos/vineyards/razbore.jpg';
import grcevje from '../assets/photos/vineyards/grcevje.jpg';
import zdinjaVas from '../assets/photos/vineyards/zdinja-vas.jpg';
import trskaGoraSoft from '../assets/photos/vineyards/trska-gora-soft.jpg';
import razboreSoft from '../assets/photos/vineyards/razbore-soft.jpg';
import grcevjeSoft from '../assets/photos/vineyards/grcevje-soft.jpg';
import zdinjaVasSoft from '../assets/photos/vineyards/zdinja-vas-soft.jpg';
import { getContent, routes, otherLang, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const v = getContent(lang).vineyards;

/*
 * The five sunny positions, each with an aerial photograph keyed by its name.
 * The names come from the translation file (they are the same in both
 * languages, being place names). A position without a photo keeps an empty
 * plate, on purpose, so an unfinished vineyard is obvious rather than quietly
 * missing.
 */
/*
 * The frame is 16:9, the aerials' own shape; a wider photo would be drawn wider
 * than its column, so `sizes` scales up to match rather than fetch too small a file.
 */
const sizesFor = (photo: ImageMetadata) => {
  const over = Math.max(1, photo.width / photo.height / (16 / 9));
  return `(max-width: 759.98px) ${Math.ceil(100 * over)}vw, ${Math.ceil(45 * over)}vw`;
};

/*
 * Each aerial comes as a pair: the parcel in focus with the land around it
 * soft, and the same photo soft all over. The page starts on the soft one and
 * brings the parcel into focus as the row scrolls up into view.
 */
const photos: Record<string, { sharp: ImageMetadata; soft: ImageMetadata }> = {
  'Trška gora': { sharp: trskaGora, soft: trskaGoraSoft },
  Razbore: { sharp: razbore, soft: razboreSoft },
  Grčevje: { sharp: grcevje, soft: grcevjeSoft },
  'Ždinja Vas': { sharp: zdinjaVas, soft: zdinjaVasSoft },
};
---

<Base lang={lang} page="vineyards" ogImage={heroPhoto} ogImageAlt={v.heroAlt}>
  <Nav lang={lang} toggleHref={routes[otherLang(lang)].vineyards} />

  <PageHero
    photo={heroPhoto}
    alt={v.heroAlt}
    title={v.title}
    standfirst={v.standfirst}
    position="50% 55%"
  />

  <main class="wrap">
    {/* One line from someone else, set like the homepage quote, then the figures. */}
    <figure class="quote quote--page" data-reveal>
      <blockquote>
        <p>{v.quote.text}</p>
      </blockquote>
      <figcaption>{v.quote.author}</figcaption>
    </figure>

    <div class="stats-lead">
      <Stats lang={lang} />
    </div>

    <section aria-labelledby="lege">
      <div class="section-gap" data-reveal>
        <h2 class="section-head" id="lege">{v.sitesHead}</h2>
      </div>

      <ul class="vineyard-list">
        {
          v.sites.map((site) => (
            <li class="vineyard" data-reveal>
              <div class="vineyard-figure" data-focus>
                {photos[site] ? (
                  <>
                    <Picture
                      class="vineyard-photo"
                      pictureAttributes={{ class: 'pic' }}
                      src={photos[site].soft}
                      formats={['avif', 'webp']}
                      fallbackFormat="jpg"
                      widths={[400, 640, 900, 1280]}
                      sizes={sizesFor(photos[site].soft)}
                      loading="lazy"
                      alt=""
                      aria-hidden="true"
                    />
                    <Picture
                      class="vineyard-photo vineyard-photo--focus"
                      pictureAttributes={{ class: 'pic' }}
                      src={photos[site].sharp}
                      formats={['avif', 'webp']}
                      fallbackFormat="jpg"
                      widths={[400, 640, 900, 1280, 1600]}
                      sizes={sizesFor(photos[site].sharp)}
                      loading="lazy"
                      alt={site}
                    />
                  </>
                ) : (
                  <p class="vineyard-placeholder">{v.photoPending}</p>
                )}
              </div>
              <div class="vineyard-body">
                <h3 class="vineyard-name">{site}</h3>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <CtaBand lang={lang} heading={v.cta.heading} secondary={v.cta.secondary} />
  </main>

  <Footer lang={lang} />
</Base>

<script>
  /*
   * Focus pull on scroll: --focus runs from 0, as a row's photo comes up from
   * the bottom of the screen, to 1 by the time it reaches the middle. The
   * stylesheet fades the in-focus layer in and settles the slight zoom on it.
   * With reduced motion, or no script, the parcel is simply in focus.
   */
  const frames = Array.from(document.querySelectorAll<HTMLElement>('[data-focus]'));
  if (frames.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let queued = false;
    const update = () => {
      queued = false;
      const vh = window.innerHeight;
      for (const frame of frames) {
        const r = frame.getBoundingClientRect();
        const middle = r.top + r.height / 2;
        const p = Math.min(1, Math.max(0, (vh - middle) / (vh * 0.45)));
        frame.style.setProperty('--focus', (p * p * (3 - 2 * p)).toFixed(3));
      }
    };
    const request = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };
    document.documentElement.classList.add('has-focus-pull');
    window.addEventListener('scroll', request, { passive: true });
    window.addEventListener('resize', request, { passive: true });
    update();
  }
</script>
