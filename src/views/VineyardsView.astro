---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import PageHero from '../components/PageHero.astro';
import Stats from '../components/Stats.astro';
import CtaBand from '../components/CtaBand.astro';
import Footer from '../components/Footer.astro';
import heroPhoto from '../assets/photos/vinogradi-hero.jpg';
import trskaGora from '../assets/photos/vineyards/trska-gora-jasno.jpg';
import razbore from '../assets/photos/vineyards/razbore-jasno.jpg';
import grcevje from '../assets/photos/vineyards/grcevje-jasno.jpg';
import zdinjaVas from '../assets/photos/vineyards/zdinja-vas-jasno.jpg';
import vinjiVrh from '../assets/photos/vineyards/vinji-vrh.jpg';
import { getContent, routes, otherLang, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const v = getContent(lang).vineyards;

/*
 * The five sunny positions, each with an aerial photograph keyed by its name.
 * The names come from the translation file (they are the same in both
 * languages, being place names). A position without a photo keeps an empty
 * plate, on purpose, so an unfinished vineyard is obvious rather than quietly
 * missing.
 */
/*
 * The frame is 16:9, the aerials' own shape; a wider photo would be drawn wider
 * than its column, so `sizes` scales up to match rather than fetch too small a file.
 */
const sizesFor = (photo: ImageMetadata) => {
  const over = Math.max(1, photo.width / photo.height / (16 / 9));
  return `(max-width: 759.98px) ${Math.ceil(100 * over)}vw, ${Math.ceil(45 * over)}vw`;
};

/*
 * The five sunny positions, each with its aerial photograph keyed by name. A
 * position without a photo keeps an empty plate, so it reads as pending.
 */
const photos: Record<string, ImageMetadata> = {
  'Trška gora': trskaGora,
  Razbore: razbore,
  Grčevje: grcevje,
  'Ždinja Vas': zdinjaVas,
  'Vinji vrh': vinjiVrh,
};
---

<Base lang={lang} page="vineyards" ogImage={heroPhoto} ogImageAlt={v.heroAlt}>
  <Nav lang={lang} toggleHref={routes[otherLang(lang)].vineyards} />

  <PageHero
    photo={heroPhoto}
    alt={v.heroAlt}
    title={v.title}
    standfirst={v.standfirst}
    position="50% 55%"
  />

  <main class="wrap">
    {/* One line from someone else, set like the homepage quote, then the figures. */}
    <figure class="quote quote--page" data-reveal>
      <blockquote>
        <p>{v.quote.text}</p>
      </blockquote>
      <figcaption>{v.quote.author}</figcaption>
    </figure>

    <div class="stats-lead">
      <Stats lang={lang} />
    </div>

    <section aria-labelledby="lege">
      <div class="section-gap" data-reveal>
        <h2 class="section-head" id="lege">{v.sitesHead}</h2>
      </div>

      <ul class="vineyard-list">
        {
          v.sites.map((site) => (
            <li class="vineyard" data-reveal>
              <div class="vineyard-figure">
                {photos[site] ? (
                  <Picture
                    class="vineyard-photo"
                    pictureAttributes={{ class: 'pic' }}
                    src={photos[site]}
                    formats={['avif', 'webp']}
                    fallbackFormat="jpg"
                    widths={[400, 640, 900, 1280, 1600]}
                    sizes={sizesFor(photos[site])}
                    loading="lazy"
                    alt={site}
                  />
                ) : (
                  <p class="vineyard-placeholder">{v.photoPending}</p>
                )}
              </div>
              <div class="vineyard-body">
                <h3 class="vineyard-name">{site}</h3>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <CtaBand lang={lang} heading={v.cta.heading} secondary={v.cta.secondary} />
  </main>

  <Footer lang={lang} />
</Base>

