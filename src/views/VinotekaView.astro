---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Footer from '../components/Footer.astro';
import heroPhoto from '../assets/photos/vinoteka-hero.jpg';
import { menu } from '../data/vinoteka-menu';
import { getContent, routes, otherLang, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang);
const c = t.vinoteka;

/* Both formatted in the page's own locale: 24,00 € and 0,75 l in Slovenian. */
const euro = new Intl.NumberFormat(t.numberLocale, {
  minimumFractionDigits: 2,
  maximumFractionDigits: 2,
});
const litres = new Intl.NumberFormat(t.numberLocale, { maximumFractionDigits: 3 });

const size = (item: { ml?: number; g?: number }) => {
  if (item.ml) return `${litres.format(item.ml / 1000)} l`;
  if (item.g) return `${litres.format(item.g)} g`;
  return undefined;
};
---

<Base lang={lang} page="vinoteka">
  <Nav lang={lang} toggleHref={routes[otherLang(lang)].vinoteka} />

  <PageHero
    photo={heroPhoto}
    alt={c.heroAlt}
    title={c.title}
    standfirst={c.standfirst}
    position="50% 30%"
  />

  {/*
    The hero opens straight onto the cenik. Every category is shut to begin
    with, so the whole list reads as a page of names; opening one drops its
    prices in under it, and the same header shuts it again.

    <details> rather than scripted panels: it opens and closes on its own, the
    keyboard and screen readers already know it, and a visitor without
    JavaScript gets the working list.
  */}
  <main class="wrap">
    {
      menu.map((section) => (
        <section aria-labelledby={`menu-${section.id}`}>
          <div class="section-gap" data-reveal>
            <h2 class="section-head" id={`menu-${section.id}`}>
              {c.menu.sections[section.id]}
            </h2>
          </div>

          <div class="menu-groups" data-reveal>
            {section.groups.map((group) => (
              <details class="menu-group" id={`g-${group.id}`}>
                <summary class="menu-group-head">
                  <span class="menu-group-name">{c.menu.groups[group.id]}</span>
                  <span class="menu-group-mark" aria-hidden="true" />
                </summary>

                <ul class="price-list">
                  {group.items.map((item) => (
                    <li class="price price--menu">
                      <p class="price-name">
                        {item.name}
                        {size(item) && <span class="price-volume tnum">{size(item)}</span>}
                      </p>
                      <p class="price-figure tnum">{euro.format(item.price)}&nbsp;€</p>
                    </li>
                  ))}
                </ul>
              </details>
            ))}
          </div>
        </section>
      ))
    }

    <p class="price-notes" data-reveal>{c.menuNote}</p>

    <section aria-labelledby="kje-in-kdaj">
      <div class="section-gap" data-reveal>
        <h2 class="section-head" id="kje-in-kdaj">{c.whereHead}</h2>
      </div>
      <div class="places places--page" data-reveal>
        <div class="place">
          <p class="place-label">{c.addressLabel}</p>
          <p class="place-name">{c.addressName}</p>
          <p class="place-copy">{c.addressCopy}</p>
        </div>
        <div class="place">
          <p class="place-label">{c.hoursLabel}</p>
          <p class="place-name tnum">{c.hours}</p>
          <p class="place-copy">
            <a href="tel:+38641871425">+386 41 871 425</a>
          </p>
        </div>
      </div>
    </section>

    <CtaBand lang={lang} heading={c.cta.heading} secondary={c.cta.secondary} />
  </main>

  <Footer lang={lang} />
</Base>
