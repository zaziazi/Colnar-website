---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Footer from '../components/Footer.astro';
import heroPhoto from '../assets/photos/vina-hero.jpg';
import { getContent, routes, otherLang, winesFor, type Lang } from '../i18n';
import { wineList } from '../data/schema';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang);

const wines = (await getCollection('wines', winesFor(lang))).sort(
  (a, b) => a.data.vrstniRed - b.data.vrstniRed
);

const slugOf = (id: string) => id.split('/').pop()!;
const pageOf = (id: string) => `${routes[lang].wines}${slugOf(id)}/`;

/*
 * A summary list: each wine's description, figures and Product markup live on
 * its own page, so the list only points at them — which is also all it shows.
 */
const schema = [
  wineList(
    new URL(routes[lang].wines, Astro.site).href,
    t,
    wines.map((wine) => ({ name: wine.data.ime, url: new URL(pageOf(wine.id), Astro.site).href })),
  ),
];
---

<Base lang={lang} page="wines" schema={schema} ogImage={heroPhoto} ogImageAlt={t.wines.heroAlt}>
  <Nav lang={lang} toggleHref={routes[otherLang(lang)].wines} />

  <PageHero
    photo={heroPhoto}
    alt={t.wines.heroAlt}
    title={t.wines.title}
    standfirst={t.wines.standfirst}
    position="50% 50%"
  />

  <main class="wrap">
    {/*
      A few quiet lines of context, then one line in gold: the way in before
      the bottles.
    */}
    <section class="wines-intro" data-reveal>
      {t.wines.intro.map((line) => <p>{line}</p>)}
      <p class="wines-statement">{t.wines.statement}</p>
    </section>

    {/*
      Each line under a small gold kicker, its bottles standing side by side
      with the name beneath in spaced capitals. Six bottles sit three and
      three; any other count stays on one row of up to four, centred.
    */}
    {
      t.wines.groups.map((group) => {
        const inGroup = wines.filter((wine) => wine.data.skupina === group.key);
        const cols = inGroup.length > 4 && inGroup.length % 3 === 0 ? 3 : Math.min(inGroup.length, 4);
        return (
          <section class="wine-line" aria-labelledby={`vina-${group.key}`}>
            <h2 class="wine-line-head" id={`vina-${group.key}`} data-reveal>
              {group.label}
            </h2>
            <ul class="wine-grid" style={`--cols: ${cols}`}>
              {inGroup.map((wine) => (
                <li class="wine-tile" data-reveal>
                  <a href={pageOf(wine.id)}>
                    <div class="wine-tile-figure">
                      {wine.data.slika ? (
                        <Picture
                          class="wine-tile-photo"
                          pictureAttributes={{ class: 'pic' }}
                          src={wine.data.slika}
                          formats={['avif', 'webp']}
                          fallbackFormat="png"
                          widths={[120, 160]}
                          sizes="120px"
                          loading="lazy"
                          alt=""
                        />
                      ) : (
                        <span class="wine-tile-pending">{t.wines.photoPending}</span>
                      )}
                    </div>
                    <h3 class="wine-tile-name">{wine.data.ime}</h3>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        );
      })
    }

    <CtaBand lang={lang} heading={t.wines.cta.heading} secondary={t.wines.cta.secondary} />
  </main>

  <Footer lang={lang} />
</Base>
