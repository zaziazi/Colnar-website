---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Footer from '../components/Footer.astro';
import heroPhoto from '../assets/photos/vina-hero.jpg';
import { getContent, routes, otherLang, winesFor, type Lang } from '../i18n';
import { wineList } from '../data/schema';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang);

const wines = (await getCollection('wines', winesFor(lang))).sort(
  (a, b) => a.data.vrstniRed - b.data.vrstniRed
);

const slugOf = (id: string) => id.split('/').pop()!;
const pageOf = (id: string) => `${routes[lang].wines}${slugOf(id)}/`;

/*
 * A summary list: each wine's description, figures and Product markup live on
 * its own page, so the list only points at them — which is also all it shows.
 */
const schema = [
  wineList(
    new URL(routes[lang].wines, Astro.site).href,
    t,
    wines.map((wine) => ({ name: wine.data.ime, url: new URL(pageOf(wine.id), Astro.site).href })),
  ),
];
---

<Base lang={lang} page="wines" schema={schema} ogImage={heroPhoto} ogImageAlt={t.wines.heroAlt}>
  <Nav lang={lang} toggleHref={routes[otherLang(lang)].wines} />

  <PageHero
    photo={heroPhoto}
    alt={t.wines.heroAlt}
    title={t.wines.title}
    standfirst={t.wines.standfirst}
    position="50% 50%"
  />

  <main class="wrap">
    {/* One line of context, set large, before the lines and their bottles. */}
    <section class="lead lead--page" data-reveal>
      <p class="lead-line">{t.wines.lead}</p>
    </section>

    {/*
      The range in four sections, each wine on a row of its own: the bottle on
      one side and its name on the other, sides alternating, so no wine is one
      tile among many. The whole row opens the wine's page.
    */}
    {
      t.wines.groups.map((group) => (
        <section aria-labelledby={`vina-${group.key}`}>
          <div class="section-gap" data-reveal>
            <h2 class="section-head" id={`vina-${group.key}`}>
              {group.label}
            </h2>
          </div>
          <ul class="wine-rows">
            {wines
              .filter((wine) => wine.data.skupina === group.key)
              .map((wine) => (
                <li class="wine-row" data-reveal>
                  <a href={pageOf(wine.id)}>
                    <div class="wine-row-figure">
                      {wine.data.slika ? (
                        <Picture
                          class="wine-row-photo"
                          pictureAttributes={{ class: 'pic' }}
                          src={wine.data.slika}
                          formats={['avif', 'webp']}
                          fallbackFormat="png"
                          widths={[120, 160]}
                          sizes="120px"
                          loading="lazy"
                          alt=""
                        />
                      ) : (
                        <span class="wine-row-pending">{t.wines.photoPending}</span>
                      )}
                    </div>
                    <h3 class="wine-row-name">{wine.data.ime}</h3>
                  </a>
                </li>
              ))}
          </ul>
        </section>
      ))
    }

    <CtaBand lang={lang} heading={t.wines.cta.heading} secondary={t.wines.cta.secondary} />
  </main>

  <Footer lang={lang} />
</Base>
