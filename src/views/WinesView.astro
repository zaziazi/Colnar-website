---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Footer from '../components/Footer.astro';
import heroPhoto from '../assets/photos/vina-hero.jpg';
import { getContent, routes, otherLang, winesFor, type Lang } from '../i18n';
import { wineList } from '../data/schema';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang);

const wines = (await getCollection('wines', winesFor(lang))).sort(
  (a, b) => a.data.vrstniRed - b.data.vrstniRed
);

const slugOf = (id: string) => id.split('/').pop()!;
const pageOf = (id: string) => `${routes[lang].wines}${slugOf(id)}/`;

/*
 * A summary list: each wine's description, figures and Product markup live on
 * its own page, so the list only points at them — which is also all it shows.
 */
const schema = [
  wineList(
    new URL(routes[lang].wines, Astro.site).href,
    t,
    wines.map((wine) => ({ name: wine.data.ime, url: new URL(pageOf(wine.id), Astro.site).href })),
  ),
];
---

<Base lang={lang} page="wines" schema={schema} ogImage={heroPhoto} ogImageAlt={t.wines.heroAlt}>
  <Nav lang={lang} toggleHref={routes[otherLang(lang)].wines} />

  <PageHero
    photo={heroPhoto}
    alt={t.wines.heroAlt}
    title={t.wines.title}
    standfirst={t.wines.standfirst}
    position="50% 50%"
  />

  <main class="wrap">
    <div class="page-intro" data-reveal>
      <p>{t.wines.lede}</p>
    </div>

    <div class="page-prose" data-reveal>
      {t.wines.prose.map((para) => <p>{para}</p>)}
    </div>

    <section aria-labelledby="seznam-vin">
      <div class="section-gap" data-reveal>
        <h2 class="section-head" id="seznam-vin">{t.wines.listHead}</h2>
      </div>

      {/*
        The shelf: bottle and name only. Everything else about a wine is one
        click away on its own page.
      */}
      <ul class="wine-grid" data-reveal>
        {
          wines.map((wine) => (
            <li class="wine-card">
              <a href={pageOf(wine.id)}>
                <div class="wine-card-figure">
                  {wine.data.slika ? (
                    <Picture
                      class="wine-card-photo"
                      pictureAttributes={{ class: 'pic' }}
                      src={wine.data.slika}
                      formats={['avif', 'webp']}
                      fallbackFormat="png"
                      widths={[110, 160]}
                      sizes="(max-width: 759.98px) 70px, 105px"
                      loading="lazy"
                      alt=""
                    />
                  ) : (
                    <span class="wine-card-pending">{t.wines.photoPending}</span>
                  )}
                </div>
                <h3 class="wine-card-name">{wine.data.ime}</h3>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <CtaBand lang={lang} heading={t.wines.cta.heading} secondary={t.wines.cta.secondary} />
  </main>

  <Footer lang={lang} />
</Base>
