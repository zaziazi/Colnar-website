---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Footer from '../components/Footer.astro';
import heroPhoto from '../assets/photos/klet-hero.jpg';
import { getContent, routes, otherLang, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = getContent(lang).cellar;
---

<Base lang={lang} page="cellar" ogImage={heroPhoto}>
  <Nav lang={lang} toggleHref={routes[otherLang(lang)].cellar} />

  <PageHero
    photo={heroPhoto}
    alt={c.heroAlt}
    title={c.title}
    standfirst={c.standfirst}
    position="50% 46%"
  />

  <main class="wrap">
    <div class="page-intro" data-reveal>
      <p>{c.lede}</p>
    </div>

    <div class="page-prose" data-reveal>
      {c.prose.map((para) => <p>{para}</p>)}
    </div>

    <section aria-labelledby="v-kleti">
      <div class="section-gap" data-reveal>
        <h2 class="section-head" id="v-kleti">{c.inCellarHead}</h2>
      </div>
      <div class="places places--page" data-reveal>
        {
          c.inCellar.map((item) => (
            <div class="place">
              <p class="place-label">{item.label}</p>
              <p class="place-name">{item.name}</p>
              <p class="place-copy">{item.copy}</p>
            </div>
          ))
        }
      </div>
    </section>

    {/*
      Address and contact, not the homepage's two-location block: the cellar
      entry there is word-for-word this page's lede, and the zidanica is a
      different building where no tasting happens.
    */}
    <section aria-labelledby="kje-nas-najdete">
      <div class="section-gap" data-reveal>
        <h2 class="section-head" id="kje-nas-najdete">{c.whereHead}</h2>
      </div>
      <div class="places places--page" data-reveal>
        <div class="place">
          <p class="place-label">{c.addressLabel}</p>
          <p class="place-name">
            <a href={c.addressMap} target="_blank" rel="noopener">{c.addressName}</a>
          </p>
          <p class="place-copy">{c.addressCopy}</p>
        </div>
        <div class="place">
          <p class="place-label">{c.contactLabel}</p>
          <p class="place-name tnum">
            <a href="tel:+38631288724">+386 31 288 724</a>
          </p>
          <p class="place-copy">
            <a href="mailto:info@colnar.si">info@colnar.si</a>
          </p>
        </div>
      </div>
    </section>

    <CtaBand lang={lang} heading={c.cta.heading} secondary={c.cta.secondary} />
  </main>

  <Footer lang={lang} />
</Base>
