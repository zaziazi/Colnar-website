---
/*
 * Layout for colnar.si/klub — the Vinoteka loyalty club. Deliberately apart from
 * Base: no nav, no age gate, no structured data, not indexed. Guests arrive here
 * from the QR on the Vinoteka counter or a link in their e-mail.
 */
import '../styles/fonts.css';
import '../styles/tokens.css';

interface Props {
  title: string;
  /** Dark ground for the card itself; warm light ground for everything else. */
  dark?: boolean;
}

const { title, dark = false } = Astro.props;
---

<!doctype html>
<html lang="sl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content={dark ? '#2d2b2b' : '#f3f2f2'} />
    {/* Saved to the home screen, the card opens like an app, under this name. */}
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Colnar klub" />
    <meta name="apple-mobile-web-app-status-bar-style" content={dark ? 'black-translucent' : 'default'} />
    <link rel="apple-touch-icon" href="/klub-icon.png" />
  </head>
  <body class:list={['klub', { dark }]}>
    <main class="klub-wrap">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  body.klub {
    margin: 0;
    min-height: 100dvh;
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  body.klub.dark {
    background: var(--color-neutral-900);
    color: var(--color-neutral-100);
  }
  .klub h1,
  .klub h2,
  .klub p {
    margin: 0;
  }
  .klub a {
    color: inherit;
  }
  .klub :focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .klub-wrap {
    max-width: 440px;
    margin: 0 auto;
    padding: max(env(safe-area-inset-top), 28px) 20px max(env(safe-area-inset-bottom), 40px);
  }
  .klub .eyebrow {
    font-family: var(--font-heading);
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent-700);
  }
  .klub.dark .eyebrow {
    color: var(--color-accent-300);
  }
  .klub .display {
    font-family: var(--font-heading);
    font-weight: 300;
    font-size: 40px;
    line-height: 1.05;
    letter-spacing: -0.01em;
  }
  .klub .rule {
    width: 48px;
    height: 1px;
    background: var(--color-accent);
    border: 0;
    margin: 18px 0;
  }
  .klub .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    min-height: 50px;
    padding: 0 20px;
    border: 0;
    border-radius: var(--radius-md);
    background: var(--color-neutral-900);
    color: var(--color-neutral-100);
    font-family: var(--font-body);
    font-size: 16px;
    cursor: pointer;
    text-decoration: none;
  }
  .klub .btn:disabled {
    opacity: 0.55;
    cursor: progress;
  }
  .klub .fine {
    font-size: 12.5px;
    line-height: 1.55;
    color: rgba(32, 31, 29, 0.62);
  }
  .klub.dark .fine {
    color: rgba(248, 244, 244, 0.6);
  }
</style>
