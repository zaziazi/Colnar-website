---
import '../styles/fonts.css';
import '../styles/site.css';
import AgeGate from '../components/AgeGate.astro';
import { getContent, alternates, otherLang, routes, type Lang, type RouteKey } from '../i18n';
import { winery, website, webPage, breadcrumb, type Node } from '../data/schema';

interface Props {
  lang: Lang;
  page: RouteKey;
  /** Nodes this page adds to the graph — its menu, its offers, its wines. */
  schema?: Node[];
}

const { lang, page, schema = [] } = Astro.props;
const t = getContent(lang);
const { title, description } = t.meta[page];

const canonical = new URL(routes[lang][page], Astro.site);
const ogImage = new URL('/og-colnar.jpg', Astro.site);

const home = new URL(routes[lang].home, Astro.site).href;

/*
 * One graph per page: the estate, the site, this page, its breadcrumb, and
 * whatever the page itself adds. Nothing is marked up here that the page does
 * not also show — the prices in the graph are the prices on the page.
 */
const graph: Node[] = [
  winery(Astro.site!, t, home, ogImage.href),
  webPage(Astro.site!, t, canonical.href, title, description, ogImage.href),
  ...(page === 'home'
    ? [website(Astro.site!, t, home)]
    : [breadcrumb(home, t.siteName, canonical.href, t.meta[page].title.split(' — ')[0])]),
  ...schema,
];

const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f3f2f2" />

    {/* Each page declares both languages, and a default for everyone else. */}
    {
      alternates(page).map((alt) => (
        <link rel="alternate" hreflang={alt.lang} href={new URL(alt.href, Astro.site).href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(routes.sl[page], Astro.site).href} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:locale:alternate" content={getContent(otherLang(lang)).ogLocale} />
    <meta property="og:site_name" content={t.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

    {/*
      Both before first paint: `js` so the hero and the reveals only hide when
      JS can show them again, and `gated` so a visitor who has not confirmed
      their age never sees the site flash behind the gate — nor a returning one
      the gate flash in front of it.
    */}
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        if (!localStorage.getItem('colnar:age-ok')) document.documentElement.classList.add('gated');
      } catch {
        document.documentElement.classList.add('gated');
      }
    </script>
  </head>
  <body>
    <AgeGate lang={lang} page={page} />
    <slot />
    <script>
      import '../scripts/motion.js';
    </script>
  </body>
</html>
