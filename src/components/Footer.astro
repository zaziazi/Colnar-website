---
import { Image } from 'astro:assets';
import Logo from './Logo.astro';
import fundingLogo from '../assets/brand/sofinanciranje-eu-skp.jpg';
import { getContent, route, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang);
---

<footer class="wrap">
  <div class="foot-cols" data-reveal>
    {
      t.footer.columns.map((column) => (
        <div>
          <p class="foot-label">{column.label}</p>
          {column.lines.map((line) => (
            <div>
              {line.map((item, i) => (
                <>
                  {i > 0 ? ' · ' : ''}
                  {
                    item.href ? (
                      <a
                        href={item.href}
                        target={item.external ? '_blank' : undefined}
                        rel={item.external ? 'noopener' : undefined}
                      >
                        {item.text}
                      </a>
                    ) : (
                      item.text
                    )
                  }
                </>
              ))}
            </div>
          ))}
        </div>
      ))
    }
  </div>

  {/*
    The co-financing marking the funding body requires, on every page: the
    official logo strip as issued, on white, linking to the page with the
    operation's particulars.
  */}
  <a class="funding-strip" href={route(lang, 'funding')}>
    <span class="funding-plate">
      <Image class="funding-logo" src={fundingLogo} alt={t.funding.logoAlt} width={406} densities={[1, 2]} />
    </span>
    <span class="funding-strip-link">{t.funding.footerLink}</span>
  </a>

  <div class="colophon">
    <Logo class="colophon-mark" label="Colnar" />
    <span>
      {t.legalName} &nbsp;·&nbsp; <span class="tnum">{t.vatLabel}: SI43099807</span>
    </span>
  </div>
</footer>
