# Netlify applies every rule that matches and the LAST value wins, so the
# catch-all has to come first — below it, the fingerprinted assets override it.

/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000

# Astro fingerprints everything under /_astro/, so it can be cached forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# No Content-Security-Policy yet: the age gate's script is inline, so a policy
# tight enough to be worth having needs its hash. Worth doing, not free.
