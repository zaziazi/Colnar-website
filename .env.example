# Kam se pošlje prijava na degustacijo.
#
# Any endpoint that accepts a multipart POST and answers 2xx works:
#   - Cloudflare Pages Function at /api/rezervacija
#   - Netlify Forms
#   - Formspree            https://formspree.io/f/<id>
#
# Leave it empty and the form still validates, but tells the visitor to write
# or call instead of pretending the reservation went through.
PUBLIC_FORM_ENDPOINT=

# Outgoing mail for the tasting bookings and the loyalty club, through the
# info@colnar.si mailbox. Set the same names in Netlify (Site configuration →
# Environment variables, scope: Functions); the password never goes in git.
SMTP_HOST=mail.colnar.si
SMTP_PORT=465
SMTP_USER=info@colnar.si
SMTP_PASS=
MAIL_FROM="Vinska klet Colnar <info@colnar.si>"

# Where tasting bookings are sent (default info@colnar.si).
RESERVATION_TO=info@colnar.si
