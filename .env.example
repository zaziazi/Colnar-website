# Kam se pošlje prijava na degustacijo.
#
# Any endpoint that accepts a multipart POST and answers 2xx works:
#   - Cloudflare Pages Function at /api/rezervacija
#   - Netlify Forms
#   - Formspree            https://formspree.io/f/<id>
#
# Leave it empty and the form still validates, but tells the visitor to write
# or call instead of pretending the reservation went through.
PUBLIC_FORM_ENDPOINT=
